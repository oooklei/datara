+                    new String(Base64.getUrlDecoder().decode(parts[0]), StandardCharsets.UTF_8), Map.class);
+            if (claims == null || !(claims.get("exp") instanceof Number)
+                    || ((Number) claims.get("exp")).longValue() < System.currentTimeMillis() / 1000) {
+                return null;
