diff --git a/dolphinscheduler-ui/src/utils/datara-bridge.ts b/dolphinscheduler-ui/src/utils/datara-bridge.ts
new file mode 100644
index 0000000..c126c75
--- /dev/null
+++ b/dolphinscheduler-ui/src/utils/datara-bridge.ts
@@ -0,0 +1,49 @@
+export interface DataraSession {
+  token: string
+  user: string
+  userToken: string
+  projectId: number
+  projectCode: string
+  apiBaseUrl: string
+  environmentGroupId?: number
+  environmentCode?: string
+}
+
+let session: DataraSession | null = null
+const waiters: Array<(value: DataraSession) => void> = []
+
+const embedded = new URLSearchParams(window.location.search).get('embed') === '1'
+export const dataraEmbed = (): boolean => embedded
+
+export function initDataraBridge(): void {
+  if (!dataraEmbed()) return
+  window.addEventListener('message', (event: MessageEvent) => {
+    if (event.source !== window.parent || event.origin !== window.location.origin) return
+    const message = event.data as { type?: string; payload?: Partial<DataraSession> } | null
+    if (message?.type !== 'datara:ds-session') return
+    const payload = message.payload
+    if (!payload || !payload.token || !payload.userToken || !payload.user ||
+        !Number.isInteger(payload.projectId) || !payload.projectCode) return
+    if (payload.apiBaseUrl && new URL(payload.apiBaseUrl, window.location.origin).origin !== window.location.origin) return
+    session = payload as DataraSession
+    waiters.splice(0).forEach((resolve) => resolve(session!))
+  })
+  window.parent.postMessage({ type: 'datara:ds-ready' }, window.location.origin)
+}
+
+export function dataraSession(): Promise<DataraSession> {
+  if (session) return Promise.resolve(session)
+  return new Promise((resolve) => waiters.push(resolve))
+}
+
+export async function dataraOptions<T>(path: string, query: Record<string, string | number> = {}): Promise<T> {
+  const current = await dataraSession()
+  const url = new URL(`${current.apiBaseUrl || window.location.origin}/api/v1/rebuild/orchestration/${path}`, window.location.origin)
+  url.searchParams.set('project_id', String(current.projectId))
+  Object.entries(query).forEach(([key, value]) => url.searchParams.set(key, String(value)))
+  const response = await fetch(url, { headers: { token: current.userToken }, credentials: 'omit' })
+  if (!response.ok) throw new Error(`Datara options unavailable: ${response.status}`)
+  const envelope = await response.json() as { code: number; data: T }
+  if (envelope.code !== 0) throw new Error('Datara options unavailable')
+  return envelope.data
+}
