+/** 拉取编排网关的原始文本（如资源脚本正文）；鉴权与 dataraOptions 一致。 */
+export async function dataraText(path: string, query: Record<string, string | number> = {}): Promise<string> {
+  const current = await dataraSession()
+  const url = new URL(`${current.apiBaseUrl || window.location.origin}/api/v1/rebuild/orchestration/${path}`, window.location.origin)
+  url.searchParams.set('project_id', String(current.projectId))
+  Object.entries(query).forEach(([key, value]) => url.searchParams.set(key, String(value)))
+  const response = await fetch(url, { headers: { token: current.userToken }, credentials: 'omit' })
+  if (!response.ok) throw new Error(`Datara resource unavailable: ${response.status}`)
+  return response.text()
+}
