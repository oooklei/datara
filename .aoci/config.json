{
  "version": 2,
  "locale": "en-US",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 24000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "exclude-agents-dir",
        "action": "exclude",
        "pattern": ".agents",
        "pattern_kind": "directory",
        "reason": "`Third-party agent skill installation (2026-10-18 15:21), not Datara product source`",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-backend-tests",
        "action": "exclude",
        "pattern": "datara-backend/tests",
        "pattern_kind": "directory",
        "reason": "Test suite; not product source needed in active cognition volume (supervision slimming plan 2026-10-19)",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-claude-dir",
        "action": "exclude",
        "pattern": ".claude",
        "pattern_kind": "directory",
        "reason": "Agent harness config and state (plans, port-ref dumps, skill bundles), not Datara product source",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-docs-archive",
        "action": "exclude",
        "pattern": "docs/archive",
        "pattern_kind": "directory",
        "reason": "Archived documents; frozen history (supervision slimming plan 2026-10-19)",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-docs-component-baseline",
        "action": "exclude",
        "pattern": "docs/组件基线化",
        "pattern_kind": "directory",
        "reason": "Legacy component baseline docs, superseded by docs/use-cases; frozen history (supervision slimming plan 2026-10-19)",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-docs-handoff-archive",
        "action": "exclude",
        "pattern": "docs/handoff/archive",
        "pattern_kind": "directory",
        "reason": "Handoff heartbeat scroll archives; frozen history (supervision slimming plan 2026-10-20 D3)",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-docs-increments",
        "action": "exclude",
        "pattern": "docs/increments",
        "pattern_kind": "directory",
        "reason": "Historical increment journals and work logs (frozen history after 2026-10-19 supervision reorg); active volume keeps docs/handoff + docs/agents",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-prototype-dir",
        "action": "exclude",
        "pattern": "prototype",
        "pattern_kind": "directory",
        "reason": "Prototype artifacts; not product source (supervision slimming plan 2026-10-19)",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-release-dir",
        "action": "exclude",
        "pattern": "release",
        "pattern_kind": "directory",
        "reason": "Release snapshot residue; not product source (supervision slimming plan 2026-10-19)",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-web-deploy",
        "action": "exclude",
        "pattern": "datara-web/deploy",
        "pattern_kind": "directory",
        "reason": "Deploy snapshot residue; not product source (supervision slimming plan 2026-10-19)",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-web-src-tests",
        "action": "exclude",
        "pattern": "datara-web/src/__tests__",
        "pattern_kind": "directory",
        "reason": "Test suite; not product source needed in active cognition volume (supervision slimming plan 2026-10-19)",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-web-tests",
        "action": "exclude",
        "pattern": "datara-web/tests",
        "pattern_kind": "directory",
        "reason": "Test suite; not product source needed in active cognition volume (supervision slimming plan 2026-10-19)",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "supervision-line",
        "order": 0,
        "enabled": true
      }
    ]
  },
  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 150000,
      "warning_tokens": 220000,
      "max_tokens": 300000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
        "max_tokens": 80
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 100,
        "max_tokens": 200
      }
    ]
  },
  "installed_agents": [],
  "automation": {
    "mode": "auto"
  },
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
